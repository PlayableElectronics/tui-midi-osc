#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
TMP_PROJECT=$(mktemp -d "${TMPDIR:-/tmp}/index-smoke.XXXXXX")
trap 'rm -rf "$TMP_PROJECT"' EXIT
cp -R examples/first-light/. "$TMP_PROJECT/"
cargo run --quiet -- run "$TMP_PROJECT" --headless
echo "smoke test passed: handshake, startup sync, staged/live commit path, monitor delivery, shutdown"
